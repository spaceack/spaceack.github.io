    </div><div class="highlight"><pre tabindex="0" class="chroma"><code class="language-fallback" data-lang="fallback"><span class="line"><span class="cl">git config --global http.proxy http://127.0.0.1:10809
</span></span><span class="line"><span class="cl">git config --global https.proxy https://127.0.0.1:1081
</span></span><span class="line"><span class="cl"># 查看代理配置
</span></span><span class="line"><span class="cl">git config --global -e
</span></span><span class="line"><span class="cl"># 取消代理
</span></span><span class="line"><span class="cl">git config --global --unset http.proxy</span></span></code></pre></div></div>]]></description></item></channel></rss>