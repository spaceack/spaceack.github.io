</span></span><span class="line"><span class="cl">or infinite time) 
</span></span><span class="line"><span class="cl">asi = sword (of discrimination) 
</span></span><span class="line"><span class="cl">dharinam = holding
</span></span><span class="line"><span class="cl">sahasra = thousands 
