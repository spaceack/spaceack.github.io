<div class="code-block code-line-numbers open" style="counter-reset: code-block 0">
    <div class="code-header language-python">
        <span class="code-title"><i class="arrow fas fa-angle-right" aria-hidden="true"></i></span>
        <span class="ellipses"><i class="fas fa-ellipsis-h" aria-hidden="true"></i></span>
        <span class="copy" title="复制到剪贴板"><i class="far fa-copy" aria-hidden="true"></i></span>
    </div><div class="highlight"><pre tabindex="0" class="chroma"><code class="language-python" data-lang="python"><span class="line"><span class="cl"><span class="n">data</span> <span class="o">=</span> <span class="p">{</span><span class="s2">&#34;column_name&#34;</span><span class="p">:[</span><span class="s2">&#34;name&#34;</span><span class="p">,</span> <span class="s2">&#34;age&#34;</span><span class="p">,</span> <span class="s2">&#34;sex&#34;</span><span class="p">],</span>
</span></span><span class="line"><span class="cl">        <span class="s2">&#34;column&#34;</span><span class="p">:</span> <span class="p">[[</span><span class="s2">&#34;Jack&#34;</span><span class="p">,</span> <span class="s2">&#34;25&#34;</span><span class="p">,</span> <span class="s2">&#34;male&#34;</span><span class="p">],</span>
</span></span><span class="line"><span class="cl">                   <span class="p">[</span><span class="s2">&#34;Rebot&#34;</span><span class="p">,</span><span class="s2">&#34;18&#34;</span><span class="p">,</span> <span class="s2">&#34;male&#34;</span><span class="p">]]}</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="n">col_ks</span> <span class="o">=</span> <span class="n">data</span><span class="o">.</span><span class="n">get</span><span class="p">(</span><span class="s2">&#34;column_name&#34;</span><span class="p">)</span>
</span></span><span class="line"><span class="cl"><span class="n">col_vs</span> <span class="o">=</span> <span class="n">data</span><span class="o">.</span><span class="n">get</span><span class="p">(</span><span class="s2">&#34;column&#34;</span><span class="p">)</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="k">def</span> <span class="nf">dict_to_table</span><span class="p">(</span><span class="n">ks</span><span class="p">,</span> <span class="n">vs</span><span class="p">):</span>
</span></span><span class="line"><span class="cl"><span class="s2">&#34;&#34;&#34;
</span></span></span><span class="line"><span class="cl"><span class="s2">desc: dict2html_table
</span></span></span><span class="line"><span class="cl"><span class="s2">&#34;&#34;&#34;</span>
</span></span><span class="line"><span class="cl">    <span class="n">th</span> <span class="o">=</span> <span class="s1">&#39;&#39;</span>
</span></span><span class="line"><span class="cl">    <span class="k">for</span> <span class="n">name</span> <span class="ow">in</span> <span class="n">ks</span><span class="p">:</span>
</span></span><span class="line"><span class="cl">        <span class="n">th</span> <span class="o">=</span> <span class="n">th</span> <span class="o">+</span> <span class="s1">&#39;&lt;th&gt;&#39;</span> <span class="o">+</span> <span class="n">name</span> <span class="o">+</span> <span class="s1">&#39;&lt;/th&gt;&#39;</span>
</span></span><span class="line"><span class="cl">    <span class="n">trth</span> <span class="o">=</span> <span class="s1">&#39;&lt;tr&gt;&#39;</span> <span class="o">+</span> <span class="n">th</span> <span class="o">+</span> <span class="s1">&#39;&lt;/tr&gt;&#39;</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl">    <span class="n">trtd</span> <span class="o">=</span> <span class="s1">&#39;&#39;</span>
</span></span><span class="line"><span class="cl">    <span class="k">for</span> <span class="n">tds</span> <span class="ow">in</span> <span class="n">vs</span><span class="p">:</span>
</span></span><span class="line"><span class="cl">        <span class="n">tdss</span> <span class="o">=</span> <span class="s1">&#39;&#39;</span>
</span></span><span class="line"><span class="cl">        <span class="k">for</span> <span class="n">td</span> <span class="ow">in</span> <span class="n">tds</span><span class="p">:</span>
</span></span><span class="line"><span class="cl">            <span class="n">tdss</span> <span class="o">=</span> <span class="n">tdss</span> <span class="o">+</span> <span class="s1">&#39;&lt;td&gt;&#39;</span> <span class="o">+</span> <span class="nb">str</span><span class="p">(</span><span class="n">td</span><span class="p">)</span> <span class="o">+</span> <span class="s1">&#39;&lt;/td&gt;&#39;</span>
</span></span><span class="line"><span class="cl">        <span class="n">tdss</span> <span class="o">=</span> <span class="s1">&#39;&lt;tr&gt;&#39;</span> <span class="o">+</span> <span class="n">tdss</span> <span class="o">+</span> <span class="s1">&#39;&lt;/tr&gt;&#39;</span>
</span></span><span class="line"><span class="cl">        <span class="n">trtd</span> <span class="o">=</span> <span class="n">trtd</span> <span class="o">+</span> <span class="n">tdss</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl">    <span class="k">return</span> <span class="s1">&#39;&lt;table&gt;&#39;</span> <span class="o">+</span> <span class="n">trth</span> <span class="o">+</span> <span class="n">trtd</span> <span class="o">+</span> <span class="s1">&#39;&lt;/table&gt;&#39;</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="nb">print</span><span class="p">(</span><span class="n">dict_to_table</span><span class="p">(</span><span class="n">col_ks</span><span class="p">,</span> <span class="n">col_vs</span><span class="p">))</span>
</span></span><span class="line"><span class="cl"><span class="c1"># &lt;table&gt;&lt;tr&gt;&lt;th&gt;name&lt;/th&gt;&lt;th&gt;age&lt;/th&gt;&lt;th&gt;sex&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Jack&lt;/td&gt;&lt;td&gt;25&lt;/td&gt;&lt;td&gt;male&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Rebot&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;male&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</span></span></span></code></pre></div></div>
