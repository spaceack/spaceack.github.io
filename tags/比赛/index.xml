</span></span><span class="line"><span class="cl"><span class="n">text</span> <span class="o">=</span> <span class="s2">&#34;welcometolq&#34;</span><span class="p">;</span> <span class="n">encryption_text</span> <span class="o">=</span> <span class="s2">&#34;ct,emlwooleq&#34;</span>
</span></span><span class="line"><span class="cl"><span class="c1"># 样例 2</span>
</span></span><span class="line"><span class="cl"><span class="n">text</span> <span class="o">=</span> <span class="s2">&#34;welcometolq &#34;</span><span class="p">;</span> <span class="n">encryption_text</span> <span class="o">=</span> <span class="s2">&#34;ct emlwooleq&#34;</span>
